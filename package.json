{
  "name": "medialplayer",
  "private": true,
  "version": "0.1.0",
  "description": "A local, Netflix-style media player for folder-based movie and TV libraries",
  "workspaces": [
    "server",
    "desktop"
  ],
  "scripts": {
    "scan": "npm run scan -w server",
    "server": "npm run dev -w server",
    "dev": "npm run dev -w desktop"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
